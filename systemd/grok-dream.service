# systemd/grok-dream.service — Phase 7.3 FIXED for user services (Fedora 43)
[Unit]
Description=GrokDreamV3 Vision-Aware Self-Improvement Daemon
After=grokforge-swarm.service

[Service]
Type=simple
WorkingDirectory=%h/AI_Projects/GrokForge/grokforge
ExecStart=/usr/bin/python -m src.grok_dream_daemon
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# Hardening
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=2G

[Install]
WantedBy=default.target
