# systemd/grokforge-swarm.service — Phase 7.3 FIXED for user services (Fedora 43)
[Unit]
Description=GrokForge Swarm ReAct + Multi-Agent Service (Phase 7)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/AI_Projects/GrokForge/grokforge
ExecStart=/usr/bin/python -m src.main_swarm
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Hardening (user-service compatible)
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryMax=4G
CPUQuota=200%
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=default.target
