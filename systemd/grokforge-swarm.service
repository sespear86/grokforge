# systemd/grokforge-swarm.service — Phase 7.2 Production Hardening (Fedora 43)
[Unit]
Description=GrokForge Swarm ReAct + Multi-Agent Service (Phase 7)
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/AI_Projects/GrokForge/grokforge
ExecStart=/usr/bin/python -m src.main_swarm
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Hardening (Fedora 43 best practices)
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
MemoryMax=4G
CPUQuota=200%
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
